{
  "multipart": [
    {
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_core" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_north" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_east" }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_south" }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_west" }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_up" }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "glasstech:block/cable/$0$/$0$_cable_down" }
    }
  ]
}